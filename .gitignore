# Private environment files. Keep blank, shareable configuration templates.
.env
.env.*
!.env.example
!.env.*.example
.envrc

# Local credentials and private key material.
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
/credentials/

# Python environments, bytecode, tools and test output.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
pytest-cache-files-*/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Node dependencies, compiled frontend and build caches.
node_modules/
dist/
dist-ssr/
.vite/
.turbo/
coverage/
*.tsbuildinfo

# Runtime databases, including SQLite WAL, SHM and journal files.
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Original collector payloads stay local. Keep backend/data/cache/ for offline demos.
/backend/data/raw/

# Keep reviewed JSON evaluation evidence; ignore ad-hoc outputs and model binaries.
/artifacts/*
!/artifacts/integration_http.json
!/artifacts/shadow_evaluation.json
!/artifacts/shadow_evaluation_real.json

# Logs and temporary files.
logs/
/lab/apache/runtime/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.bak

# Local editor and operating-system metadata.
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# IP geolocation databases (DB-IP Lite, ~140 MB, download per PLAN_ip_geolocation.md)
/backend/data/geo/
