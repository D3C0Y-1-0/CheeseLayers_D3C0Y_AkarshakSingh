# Copy to .env and fill in. Never commit .env.
# true = collectors read only from data/cache (no network) — use this for the live demo.
DEMO_MODE=false
# Optional: raises NVD rate limit from 5 to 50 requests / 30s. https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Free key for ThreatFox / URLhaus / MalwareBazaar. https://auth.abuse.ch/
ABUSECH_AUTH_KEY=
# Free key for AlienVault OTX. https://otx.alienvault.com/ (Settings → API key)
OTX_API_KEY=
# Optional: GitHub token (no scopes needed) — raises API limit from 60 to 5000/hour.
GITHUB_TOKEN=

# Member 4: template works without an API key. DEMO_MODE=true disables ALL cloud LLM calls.
LLM_PROVIDER=template
LLM_MODEL=
LLM_API_KEY=
# Explicit opt-in: when true and DEMO_MODE=false, bounded incident facts are sent to Groq.
# Raw log bodies/command lines are excluded. Keep false for local/template-only operation.
LLM_ALLOW_CLOUD=false
LLM_TIMEOUT_SECONDS=5
